# PriceLabs Customer API
# Get this from: PriceLabs → Account Settings → Enable Customer API
PRICELABS_API_KEY=your_api_key_here

# Supabase (Hub)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Service role key — server-side only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Dashboard Manager (/admin) — single shared password. Server-only.
# Changing it signs everyone out.
ADMIN_PASSWORD=change_me
# Base URL for the share links shown in /admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
